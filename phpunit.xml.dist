<?xml version="1.0" encoding="UTF-8"?>
<phpunit
	bootstrap="tests/bootstrap.php"
	colors="true"
	beStrictAboutTestsThatDoNotTestAnything="true"
	failOnWarning="true"
	failOnRisky="true">
	<testsuites>
		<testsuite name="linguator-unit">
			<directory prefix="test-" suffix=".php">tests</directory>
		</testsuite>
	</testsuites>
</phpunit>
